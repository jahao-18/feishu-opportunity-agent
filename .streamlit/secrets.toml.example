# Copy these keys into the Streamlit Community Cloud Secrets panel.
# Never commit a real secrets.toml file.
MOCK_MODE = "false"
ARK_API_KEY = "replace-me"
ARK_BASE_URL = "https://ark.cn-beijing.volces.com/api/v3"
ARK_MODEL = "doubao-seed-2-1-pro-260628"
ARK_STRUCTURED_MODE = "tool_call"
ARK_TIMEOUT_SECONDS = "30"
ARK_MAX_RETRIES = "2"
ARK_FALLBACK_TO_MOCK = "true"

FEISHU_SYNC_ENABLED = "true"
FEISHU_APP_ID = "replace-me"
FEISHU_APP_SECRET = "replace-me"
FEISHU_BITABLE_APP_TOKEN = "replace-me"
FEISHU_BITABLE_TABLE_ID = "replace-me"
FEISHU_STAGE_RULES_TABLE_ID = "replace-me"
FEISHU_EVAL_TABLE_ID = "replace-me"

PUBLIC_DEMO_MODE = "true"
ANALYSIS_RATE_LIMIT = "6"
ANALYSIS_RATE_WINDOW_SECONDS = "600"
FEISHU_PUBLIC_SAVE_ENABLED = "false"
DEMO_WRITE_CODE = "replace-with-a-strong-demo-code"
