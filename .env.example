# Keep true until an Ark API key is configured.
MOCK_MODE=true

# Volcengine Ark / Doubao
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=
ARK_STRUCTURED_MODE=tool_call
ARK_TIMEOUT_SECONDS=30
ARK_MAX_RETRIES=2
# Only enable for a live-demo fallback; fallback results are marked for review.
ARK_FALLBACK_TO_MOCK=false

# Feishu Bitable synchronization
FEISHU_SYNC_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
# Optional: when configured, S0-S5 rules are read from this table with local fallback.
FEISHU_STAGE_RULES_TABLE_ID=
FEISHU_EVAL_TABLE_ID=
FEISHU_TIMEOUT_SECONDS=20
FEISHU_MAX_RETRIES=2

# Public deployment protection
PUBLIC_DEMO_MODE=true
ANALYSIS_RATE_LIMIT=6
ANALYSIS_RATE_WINDOW_SECONDS=600
# Public writes fail closed unless both this flag and DEMO_WRITE_CODE are configured.
FEISHU_PUBLIC_SAVE_ENABLED=false
# Share this code only with the interviewer; rotate or disable it after the interview.
DEMO_WRITE_CODE=
